{
  "name": "scotdance-challenge",
  "description": "Motivate your progress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:functions emulate dev:www",
    "dev:www": "vite --host",
    "dev:prod": "VITE_FIREBASE_EMULATORS=false vite",
    "dev:functions": "npm run --prefix functions/ dev",
    "emulate": "firebase emulators:start --import=.firebase/emulator-data --export-on-exit",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:functions": "npm run --prefix functions/ build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ e2e/",
    "test:e2e": "node e2e/ensure-secret.mjs && npm run build:functions && firebase emulators:exec --only auth,firestore,functions \"playwright test\"",
    "test": "npm run test:e2e",
    "deploy": "npm run build && firebase deploy --only hosting",
    "analyze": "ANALYZE=true vite build",
    "postinstall": "npm --prefix ./functions/ i"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "countries-list": "^3.4.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "uqr": "0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.0",
    "firebase-tools": "^15.34.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
